{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "punch2pen",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // PostHog project token is public by design (it ships in every page). POSTHOG_HOST
  // is the PostHog managed reverse proxy (CNAME flow -> proxyhog, DNS only).
  "vars": {
    "POSTHOG_KEY": "phc_OkIBjdD7uPJfUGtLkYzBbNYZQhQMY7cDbr1U28Tll9t",
    "POSTHOG_HOST": "https://flow.punch2pen.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/env.js"]
  },
  "routes": [
    { "pattern": "punch2pen.com", "custom_domain": true },
    { "pattern": "www.punch2pen.com", "custom_domain": true }
  ]
}
