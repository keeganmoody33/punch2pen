{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "punch2pen",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/env.js"]
  },
  "routes": [
    { "pattern": "punch2pen.com", "custom_domain": true },
    { "pattern": "www.punch2pen.com", "custom_domain": true }
  ]
}
