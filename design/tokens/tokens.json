{
  "$description": "Punch2Pen design tokens. Direction locked 2026-09-30: marker green (sampled from the founder's sketches) on the Open graphite DAW chrome (plugin #21). Semantic names match the CSS variables already used by plugin/Source/ui/public/index.html and site/public/site.css. Run `node design/tokens/build.mjs` to regenerate tokens.css.",

  "color": {
    "graphite": {
      "$type": "color",
      "950": { "$value": "#14151A", "$description": "Transcript pane. Darkest surface." },
      "900": { "$value": "#1E1E1E", "$description": "Window / editor behind the WebView. Site page ground." },
      "850": { "$value": "#22242A", "$description": "Chrome: header, transport strip, status bar, site nav." },
      "800": { "$value": "#2A2D34", "$description": "Raised: pill, popover, sheet, Return to Live, inputs." },
      "700": { "$value": "#353943", "$description": "Hover on raised." },
      "600": { "$value": "#4A4F5B", "$description": "Solid divider when alpha lines are not possible." }
    },
    "ink": {
      "$type": "color",
      "base": { "$value": "#F3F4F6", "$description": "Text on graphite." },
      "2": { "$value": "rgba(243, 244, 246, 0.74)", "$description": "Secondary text. 8.9:1 on pane." },
      "3": { "$value": "rgba(243, 244, 246, 0.54)", "$description": "Tertiary labels. Raised from shipped 0.48 so chrome labels clear 4.5:1." },
      "4": { "$value": "rgba(243, 244, 246, 0.30)", "$description": "Disabled and decoration only. Never running text." },
      "line": { "$value": "rgba(255, 255, 255, 0.08)", "$description": "Hairline divider." },
      "line-strong": { "$value": "rgba(255, 255, 255, 0.14)", "$description": "Control borders." }
    },
    "green": {
      "$type": "color",
      "$description": "Hue 164. 700 is the marker, sampled from the index-card bolt and white-balanced to the paper. 400 is the same hue lifted for graphite.",
      "50":  { "$value": "#E1F4EF" },
      "100": { "$value": "#BBE7DB" },
      "200": { "$value": "#8CD9C4" },
      "300": { "$value": "#64CEB2", "$description": "Accent hover on graphite." },
      "400": { "$value": "#43C7A3", "$description": "Accent on graphite. 7.3:1 on chrome, 8.6:1 on pane." },
      "500": { "$value": "#3DA488" },
      "600": { "$value": "#32856F" },
      "700": { "$value": "#2A6F5D", "$description": "Marker. Brand ink on paper, 5.7:1. Decorative only on graphite (2.6:1)." },
      "800": { "$value": "#21594A" },
      "900": { "$value": "#153C32" },
      "950": { "$value": "#0B1F18", "$description": "Text on a green fill. 8.1:1 on green-400." }
    },
    "signal": {
      "$type": "color",
      "rec":  { "$value": "#FF453A", "$description": "Recording. The only red in the product UI." },
      "wait": { "$value": "#D7B07A", "$description": "Engine not connected (WAIT) and caution copy." }
    },
    "pad": {
      "$type": "color",
      "$description": "The index card from the 2PEN sketch. Used for lyric sheets, exports, and site moments where the words land on paper. Never inside the plugin chrome.",
      "paper":  { "$value": "#FBFAF7" },
      "paper-2": { "$value": "#F1EFE8", "$description": "Shade under a sheet." },
      "rule":   { "$value": "#A9C6DE", "$description": "Blue ruled lines." },
      "redline": { "$value": "#E07A6C", "$description": "The red header rule of an index card, under the title. The one decorative red. Never on a control." },
      "ink":    { "$value": "#1C1917", "$description": "Marker black on paper." },
      "ink-2":  { "$value": "rgba(28, 25, 23, 0.68)" },
      "green":  { "$value": "{color.green.700}" }
    }
  },

  "semantic": {
    "$description": "Role tokens. These names are the CSS variables the plugin and site already use.",
    "bg-deep":     { "$type": "color", "$value": "{color.graphite.900}" },
    "bg-pane":     { "$type": "color", "$value": "{color.graphite.950}" },
    "bg-chrome":   { "$type": "color", "$value": "{color.graphite.850}" },
    "bg-raised":   { "$type": "color", "$value": "{color.graphite.800}" },
    "bg-hover":    { "$type": "color", "$value": "{color.graphite.700}" },
    "line":        { "$type": "color", "$value": "{color.ink.line}" },
    "line-strong": { "$type": "color", "$value": "{color.ink.line-strong}" },
    "ink":         { "$type": "color", "$value": "{color.ink.base}" },
    "ink-2":       { "$type": "color", "$value": "{color.ink.2}" },
    "ink-3":       { "$type": "color", "$value": "{color.ink.3}" },
    "ink-4":       { "$type": "color", "$value": "{color.ink.4}" },
    "accent":      { "$type": "color", "$value": "{color.green.400}" },
    "accent-hover":{ "$type": "color", "$value": "{color.green.300}" },
    "accent-ink":  { "$type": "color", "$value": "{color.green.950}" },
    "accent-dim":  { "$type": "color", "$value": "rgba(67, 199, 163, 0.16)", "$description": "Selection wash, seek flash, focus halo." },
    "marker":      { "$type": "color", "$value": "{color.green.700}" },
    "rec":         { "$type": "color", "$value": "{color.signal.rec}" },
    "wait":        { "$type": "color", "$value": "{color.signal.wait}" },
    "play":        { "$type": "color", "$value": "{color.green.400}", "$description": "PLAY, LIVE, corrected marker. Same as accent: green means the pen is live." },
    "pad-paper":   { "$type": "color", "$value": "{color.pad.paper}" },
    "pad-shade":   { "$type": "color", "$value": "{color.pad.paper-2}" },
    "pad-rule":    { "$type": "color", "$value": "{color.pad.rule}" },
    "pad-redline": { "$type": "color", "$value": "{color.pad.redline}" },
    "pad-ink":     { "$type": "color", "$value": "{color.pad.ink}" },
    "pad-ink-2":   { "$type": "color", "$value": "{color.pad.ink-2}" },
    "pad-green":   { "$type": "color", "$value": "{color.pad.green}" }
  },

  "font": {
    "$type": "fontFamily",
    "display": { "$value": "\"Archivo\", \"Arial Narrow\", \"Roboto Condensed\", system-ui, sans-serif", "$description": "Site and brand headlines only. Set with font-stretch 68% and weight 800 to 900. Loaded from Google Fonts on the site. Not loaded in the plugin." },
    "sans":    { "$value": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", \"Segoe UI\", sans-serif", "$description": "UI text and lyrics. System face, no network." },
    "mono":    { "$value": "\"SF Mono\", ui-monospace, Menlo, Consolas, monospace", "$description": "The punch: clock, bar and beat, badges, labels." }
  },
  "font-stretch": {
    "display": { "$type": "number", "$value": "68%" }
  },

  "size": {
    "$type": "dimension",
    "plugin": {
      "badge":  { "$value": "9px",    "$description": "Status badge caps." },
      "micro":  { "$value": "10.5px", "$description": "Pill, transport caps." },
      "body":   { "$value": "12px",   "$description": "Status bar, popover body." },
      "ui":     { "$value": "13px",   "$description": "Wordmark, sheet input." },
      "lyric":  { "$value": "16px",   "$description": "Past and upcoming lines." },
      "title":  { "$value": "24px",   "$description": "Active line. Scales with the editor width." }
    },
    "site": {
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "22px" },
      "2xl": { "$value": "28px" },
      "3xl": { "$value": "40px" },
      "4xl": { "$value": "56px" },
      "5xl": { "$value": "80px" },
      "6xl": { "$value": "112px" }
    }
  },

  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "2px" },
    "2": { "$value": "4px" },
    "3": { "$value": "6px" },
    "4": { "$value": "8px" },
    "5": { "$value": "12px" },
    "6": { "$value": "16px" },
    "7": { "$value": "20px" },
    "8": { "$value": "24px" },
    "9": { "$value": "32px" },
    "10": { "$value": "40px" },
    "11": { "$value": "56px" },
    "12": { "$value": "80px" },
    "13": { "$value": "120px" }
  },

  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "3px", "$description": "Active-word plate." },
    "sm":   { "$value": "5px", "$description": "Controls. Shipped --radius." },
    "md":   { "$value": "8px", "$description": "Cards, sheets." },
    "lg":   { "$value": "12px", "$description": "Plugin frame, site media." },
    "pill": { "$value": "999px" }
  },

  "motion": {
    "fast":  { "$type": "duration", "$value": "120ms", "$description": "Hover, border, color." },
    "base":  { "$type": "duration", "$value": "200ms", "$description": "Sheet and popover in." },
    "slow":  { "$type": "duration", "$value": "320ms", "$description": "Synced scroll step." },
    "hold":  { "$type": "duration", "$value": "750ms", "$description": "Highlight holds on the last sung word after the final timestamp." },
    "pulse": { "$type": "duration", "$value": "1300ms", "$description": "REC dot pulse." },
    "ease-out": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] },
    "ease-in-out": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
  },

  "shadow": {
    "pop":   { "$type": "shadow", "$value": "0 12px 32px rgba(0, 0, 0, 0.45)", "$description": "Popover, sheet." },
    "frame": { "$type": "shadow", "$value": "0 24px 48px rgba(0, 0, 0, 0.45)", "$description": "Plugin window on the site." },
    "sheet": { "$type": "shadow", "$value": "0 1px 0 rgba(28, 25, 23, 0.06), 0 18px 40px rgba(0, 0, 0, 0.35)", "$description": "Pad lyric sheet on graphite." }
  },

  "lyric": {
    "past":     { "$type": "number", "$value": 0.38, "$description": "Temporal Hierarchy opacity. Unchanged from HANDOFF.md." },
    "upcoming": { "$type": "number", "$value": 0.68 },
    "active":   { "$type": "number", "$value": 1 },
    "line-height": { "$type": "number", "$value": 1.42 },
    "focal-play": { "$type": "number", "$value": 0.40, "$description": "Active line sits 40% down the pane during playback." },
    "focal-rec":  { "$type": "number", "$value": 0.60, "$description": "60% while recording." }
  },

  "layout": {
    "$type": "dimension",
    "plugin-width":     { "$value": "400px", "$description": "Default editor width (PluginEditor setSize)." },
    "plugin-height":    { "$value": "600px" },
    "plugin-min":       { "$value": "400px", "$description": "Minimum width and height." },
    "header-height":    { "$value": "44px" },
    "transport-height": { "$value": "30px" },
    "status-height":    { "$value": "30px" },
    "site-max":         { "$value": "1120px" },
    "site-gutter":      { "$value": "24px" }
  }
}
